{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@workspace/db": ["../../lib/db/src/index.ts"],
      "@workspace/db/*": ["../../lib/db/src/*"],
      "@workspace/api-zod": ["../../lib/api-zod/src/index.ts"],
      "@workspace/api-zod/*": ["../../lib/api-zod/src/*"],
      "@workspace/hermes": ["../../lib/hermes/src/index.ts"],
      "@workspace/hermes/*": ["../../lib/hermes/src/*"],
      "@/*": ["../../artifacts/shothik/src/*"]
    },
    "types": ["node"]
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../lib/db"
    },
    {
      "path": "../../lib/api-zod"
    }
  ]
}
