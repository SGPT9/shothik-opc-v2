# ==============================================================================
# SHOTHIKGPT PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# Canonical Production Domain: https://shothikgpt.com
# API Gateway Endpoint:        https://api.shothikgpt.com
# Asset CDN Storage:           https://cdn.shothikgpt.com
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
CANONICAL_DOMAIN=shothikgpt.com
CORS_ORIGIN=https://shothikgpt.com,https://api.shothikgpt.com

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL & InsForge Cloud BaaS)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?sslmode=require
INSFORGE_URL=https://[PROJECT_ID].ap-southeast.database.insforge.app
INSFORGE_ANON_KEY=eyJhbGciOi...
INSFORGE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE R2 OBJECT STORAGE (Zero-Egress Asset CDN)
# ------------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=[CF_ACCOUNT_ID]
CLOUDFLARE_R2_ACCESS_KEY_ID=[R2_ACCESS_KEY]
CLOUDFLARE_R2_SECRET_ACCESS_KEY=[R2_SECRET_KEY]
CLOUDFLARE_R2_BUCKET_NAME=shothik-prod-assets
CLOUDFLARE_R2_PUBLIC_DOMAIN=cdn.shothikgpt.com

# ------------------------------------------------------------------------------
# 4. AI & FRONTIER MODEL INFERENCE KEYS
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 5. BANGLADESH MFS (bKash & Nagad Direct PGW)
# ------------------------------------------------------------------------------
# bKash PGW Live Credentials (https://developer.bKash.com)
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=[LIVE_BKASH_APP_KEY]
BKASH_APP_SECRET=[LIVE_BKASH_APP_SECRET]
BKASH_USERNAME=[LIVE_BKASH_USERNAME]
BKASH_PASSWORD=[LIVE_BKASH_PASSWORD]
BKASH_CALLBACK_URL=https://shothikgpt.com/api/v1/mfs/bkash/callback

# Nagad Direct PGW Live Credentials (https://nagad.com.bd)
NAGAD_BASE_URL=https://api.nagad.com.bd
NAGAD_MERCHANT_ID=[LIVE_NAGAD_MERCHANT_ID]
NAGAD_PUBLIC_KEY=[LIVE_NAGAD_PUBLIC_KEY]
NAGAD_PRIVATE_KEY=[LIVE_NAGAD_PRIVATE_KEY]
NAGAD_CALLBACK_URL=https://shothikgpt.com/api/v1/mfs/nagad/callback

# ------------------------------------------------------------------------------
# 6. LOGISTICS & COURIER DISPATCH (Steadfast, Pathao, REDX)
# ------------------------------------------------------------------------------
STEADFAST_API_KEY=[LIVE_STEADFAST_API_KEY]
STEADFAST_SECRET_KEY=[LIVE_STEADFAST_SECRET_KEY]
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1

PATHAO_CLIENT_ID=[LIVE_PATHAO_CLIENT_ID]
PATHAO_CLIENT_SECRET=[LIVE_PATHAO_CLIENT_SECRET]
PATHAO_USERNAME=[LIVE_PATHAO_USERNAME]
PATHAO_PASSWORD=[LIVE_PATHAO_PASSWORD]
PATHAO_BASE_URL=https://courier.pathao.com/aladdin/api/v1

# ------------------------------------------------------------------------------
# 7. SECURITY & ENCRYPTION
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-random-32-character-jwt-key
USER_KEY_VAULT_MASTER_KEY=32-byte-hex-encoded-aes-256-gcm-master-key
ENCRYPTION_SALT=random-salt-string-for-hash-derivation
