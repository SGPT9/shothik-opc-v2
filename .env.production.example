# ==============================================================================
# SHOTHIKGPT PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# Canonical Production Domain: https://shothikgpt.com
# API Gateway Endpoint:        https://api.shothikgpt.com
# Asset CDN Storage:           https://cdn.shothikgpt.com
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
CANONICAL_DOMAIN=shothikgpt.com
CORS_ORIGIN=https://shothikgpt.com,https://api.shothikgpt.com

# ------------------------------------------------------------------------------
# 2. FRONTEND (Vite / Next.js Client-Exposed Variables)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://shothikgpt.com
NEXT_PUBLIC_API_URL=https://api.shothikgpt.com
NEXT_PUBLIC_STREAMING_ENABLED=true
NEXT_PUBLIC_WRITING_STUDIO_ENABLED=true
VITE_APP_URL=https://shothikgpt.com
VITE_API_URL=https://api.shothikgpt.com
VITE_SHOW_DEBUG=false
VITE_CONVEX_URL=https://dashing-mandrill-233.convex.cloud

# ------------------------------------------------------------------------------
# 3. DATABASE & PERSISTENCE
# ------------------------------------------------------------------------------
# Primary PostgreSQL (InsForge Cloud BaaS / Self-Hosted Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?sslmode=require

# InsForge REST/GraphQL BaaS Client
INSFORGE_URL=https://[PROJECT_ID].ap-southeast.database.insforge.app
INSFORGE_ANON_KEY=eyJhbGciOi...
INSFORGE_SERVICE_ROLE_KEY=eyJhbGciOi...
NEXT_PUBLIC_INSFORGE_URL=https://[PROJECT_ID].ap-southeast.database.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=eyJhbGciOi...

# Edge SQLite Zero-Downtime Fallback Store
SQLITE_DATABASE_URL=file:/app/data/shothik_local.db

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 OBJECT STORAGE (Zero-Egress Asset CDN)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=[CF_ACCOUNT_ID]
CLOUDFLARE_R2_ACCESS_KEY_ID=[R2_ACCESS_KEY]
CLOUDFLARE_R2_SECRET_ACCESS_KEY=[R2_SECRET_KEY]
CLOUDFLARE_R2_BUCKET=shothik-prod-assets
CLOUDFLARE_R2_PUBLIC_DOMAIN=cdn.shothikgpt.com

# ------------------------------------------------------------------------------
# 5. AI & FRONTIER MODEL INFERENCE
# ------------------------------------------------------------------------------
# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o

# Anthropic (Claude 3.5 Sonnet, Claude 3 Opus)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenRouter (Unified multi-model aggregator for overnight batch & agent swarms)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# DeepSeek & Moonshot Kimi
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
KIMI_API_KEY=sk-...
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Google Gemini
GEMINI_API_KEY=AIzaSy...

# Self-Hosted Local/VPS LLM Inference (Ollama / vLLM / SGLang)
OLLAMA_HOST=http://127.0.0.1:11434
TONIGHT_ENGINE_SELF_HOSTED_URL=
TONIGHT_ENGINE_SELF_HOSTED_MODEL=ornith-1.0:9b
FREETOKEN_HOST=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 6. BANGLADESH MFS (bKash & Nagad Direct PGW)
# ------------------------------------------------------------------------------
# bKash PGW Live Credentials (https://developer.bKash.com)
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=[LIVE_BKASH_APP_KEY]
BKASH_APP_SECRET=[LIVE_BKASH_APP_SECRET]
BKASH_USERNAME=[LIVE_BKASH_USERNAME]
BKASH_PASSWORD=[LIVE_BKASH_PASSWORD]
BKASH_CALLBACK_URL=https://shothikgpt.com/api/v1/mfs/bkash/callback

# Nagad Direct PGW Live Credentials (https://nagad.com.bd)
NAGAD_BASE_URL=https://api.nagad.com.bd
NAGAD_MERCHANT_ID=[LIVE_NAGAD_MERCHANT_ID]
NAGAD_PUBLIC_KEY=[LIVE_NAGAD_PUBLIC_KEY]
NAGAD_PRIVATE_KEY=[LIVE_NAGAD_PRIVATE_KEY]
NAGAD_CALLBACK_URL=https://shothikgpt.com/api/v1/mfs/nagad/callback

# ------------------------------------------------------------------------------
# 7. LOGISTICS & COURIER DISPATCH (Steadfast & Pathao)
# ------------------------------------------------------------------------------
# Steadfast Courier (https://portal.steadfast.com.bd)
STEADFAST_API_KEY=[LIVE_STEADFAST_API_KEY]
STEADFAST_SECRET_KEY=[LIVE_STEADFAST_SECRET_KEY]
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1

# Pathao Logistics (https://merchant.pathao.com)
PATHAO_CLIENT_ID=[LIVE_PATHAO_CLIENT_ID]
PATHAO_CLIENT_SECRET=[LIVE_PATHAO_CLIENT_SECRET]
PATHAO_USERNAME=[LIVE_PATHAO_USERNAME]
PATHAO_PASSWORD=[LIVE_PATHAO_PASSWORD]
PATHAO_BASE_URL=https://api-hermes.pathao.com

# ------------------------------------------------------------------------------
# 8. SOCIAL, MESSAGING & WEBHOOKS
# ------------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=[SECURE_RANDOM_WHATSAPP_VERIFY_TOKEN]
TAVILY_API_KEY=tvly-...

# ------------------------------------------------------------------------------
# 9. SECURITY & ENCRYPTION
# ------------------------------------------------------------------------------
JWT_SECRET=[SUPER_SECRET_RANDOM_32_CHAR_STRING]
KEY_VAULT_SECRET=[32_BYTE_HEX_ENCODED_AES_256_GCM_KEY]
BETTER_AUTH_SECRET=[SUPER_SECRET_AUTH_KEY]
ENCRYPTION_SALT=[RANDOM_SALT_STRING]

# ------------------------------------------------------------------------------
# 10. OBSERVABILITY & TELEMETRY
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=

