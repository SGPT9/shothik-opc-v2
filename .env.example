# shothik-web environment variables
#
# Rules:
# - Anything prefixed with NEXT_PUBLIC_ is exposed to the browser.
# - Do not put secrets in NEXT_PUBLIC_ variables.
# - Do not commit .env.local or any real secret values.
#
# Setup:
#   cp .env.example .env.local
#   edit .env.local

################################################################################
# Public (Browser) – safe to expose
################################################################################

# App and external API routing
NEXT_PUBLIC_APP_URL=https://shothik.work
NEXT_PUBLIC_API_URL=https://shothik.work
NEXT_PUBLIC_DEERFLOW_BACKEND_URL=http://localhost:8000
DEERFLOW_BACKEND_URL=http://localhost:8000

# Feature flags
# Set to "false" to disable token-level SSE streaming and fall back to wait-then-render.
# Default is true (streaming on). Change requires no code deploy.
NEXT_PUBLIC_STREAMING_ENABLED=true

# Some modules use a base URL that already includes a path prefix. If unsure,
# set this equal to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_URL_WITH_PREFIX=https://shothik.work

# Tool rewrites / socket prefixes
NEXT_PUBLIC_PARAPHRASE_REDIRECT_PREFIX=paraphrase

# Optional: if set, paraphrase socket connects directly to this URL.
# If unset, the app uses "/${NEXT_PUBLIC_PARAPHRASE_REDIRECT_PREFIX}/socket.io".
NEXT_PUBLIC_PARAPHRASE_SOCKET_URL=

# Optional: required for Sheet features (set to the service prefix used by your API).
NEXT_PUBLIC_SHEET_REDIRECT_PREFIX=

# Optional: used by the presentation tool for socket transport
NEXT_PUBLIC_SOCKET_URL=

# Database — PostgreSQL (InsForge Cloud) + SQLite (Local Edge)
DATABASE_URL=postgresql://postgres:password@ers8j28a.ap-southeast.database.insforge.app:5432/insforge?sslmode=require

# InsForge client (used for the ongoing backend migration)
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Social login (if enabled in the UI)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Payments (public key only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# Analytics and error tracking
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# Feature flags
NEXT_PUBLIC_WRITING_STUDIO_ENABLED=true
NEXT_PUBLIC_WRITING_STUDIO_API_URL=
NEXT_PUBLIC_ENABLE_PARAPHRASE_SIMPLIFIED=true
NEXT_PUBLIC_EXTRACT_PDF_V2_ENABLED=false

################################################################################
# Server-only (Node / API routes) – secrets must live here
################################################################################

# Auth (Better Auth — Clerk has been removed)
# Sign-in/sign-up route paths are kept for URL routing compatibility
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/register

# LLM providers (at least one required by env validation)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-thinking
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# Tonight Engine — overnight batch processing
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TAVILY_API_KEY=
TONIGHT_ENGINE_MAX_TOKENS=8192
TONIGHT_ENGINE_SELF_HOSTED_URL=
TONIGHT_ENGINE_SELF_HOSTED_MODEL=ornith-1.0:9b
TONIGHT_ENGINE_SELF_HOSTED_API_KEY=
TONIGHT_ENGINE_COLIBRI_URL=

# Stripe (server)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_CREDITS_WEBHOOK_SECRET=
STRIPE_STARS_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=
CREDIT_PURCHASE_SECRET=

# Razorpay (server)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=

# PublishDrive (publishing)
PUBLISHDRIVE_ENABLED=true
NEXT_PUBLIC_PUBLISHDRIVE_ENABLED=true
NEXT_PUBLIC_PUBLISHDRIVE_API_URL=https://api.publishdrive.com/v1
PUBLISHDRIVE_API_KEY=
PUBLISHDRIVE_WEBHOOK_SECRET=

# Calibre microservice
CALIBRE_SERVICE_URL=http://localhost:3003

# Redis / Upstash (used by idempotency and rate limiting helpers)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
REDIS_TOKEN=

# Security and ops
METRICS_ADMIN_KEY=
IP_ALLOWLIST=

# Optional: MongoDB (only required if features using dbConnect are enabled)
MONGODB_URI=

################################################################################
# Document parsing (LiteParse)
################################################################################

LITEPARSE_ENABLED=false
LITEPARSE_MODE=shadow
LITEPARSE_OCR_LANGUAGE=eng
LITEPARSE_OCR_SERVER_URL=
LITEPARSE_DPI=150
LITEPARSE_MAX_PAGES=40
LITEPARSE_NUM_WORKERS=1
LITEPARSE_DISABLE_OCR=false

# InsForge BaaS (used for Database, RAG Memory, Storage, Edge Functions)
INSFORGE_URL=https://ers8j28a.ap-southeast.insforge.app
INSFORGE_API_KEY=
VITE_INSFORGE_URL=https://ers8j28a.ap-southeast.insforge.app
VITE_INSFORGE_ANON_KEY=

# Cloudflare Turnstile Bot Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# South Asian MFS & Logistics Gateway (bKash / Nagad / Steadfast / Pathao)
BKASH_MERCHANT_KEY=
BKASH_MERCHANT_SECRET=
NAGAD_MERCHANT_KEY=
NAGAD_MERCHANT_SECRET=
STEADFAST_API_KEY=
PATHAO_CLIENT_SECRET=

# Vast.ai Cloud GPU Bursting & Vespa Hybrid RAG Engine
VASTAI_API_KEY=
VASTAI_ENDPOINT=http://127.0.0.1:8000/v1
VESPA_ENDPOINT=http://localhost:8080
VESPA_SCHEMA=doc_chunk

################################################################################
# Canonical Express API Server (artifacts/api-server) & Companion Services
################################################################################

# Server Ports & CORS
PORT=8080
FRONTEND_PORT=5000
CORS_ORIGIN=https://shothik.work,http://localhost:5000

# Mandatory in production (NODE_ENV=production)
JWT_SECRET=
CF_ACCESS_ENABLED=false

# Adaptive Inference Gateway Providers (NVIDIA NIM, DeepSeek Cloud, Ollama, FreeToken)
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
OLLAMA_HOST=http://127.0.0.1:11434
FREETOKEN_HOST=http://127.0.0.1:8000

# Companion Bangla Voice AI Microservice (bangla-audio-ai)
BANGLA_AUDIO_AI_URL=http://127.0.0.1:8001

# Local / Edge SQLite & LibSQL (Turso)
SQLITE_DB_PATH=data/shothik_local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Better Auth
BETTER_AUTH_URL=https://shothik.work
NEXT_PUBLIC_BETTER_AUTH_URL=https://shothik.work
BETTER_AUTH_SECRET=
