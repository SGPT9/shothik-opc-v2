{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/shothik run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:mockup": "pnpm --filter @workspace/mockup-sandbox run dev",
    "dev:all": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-all.ps1",
    "preinstall": "node -e \"if(!/pnpm/.test(process.env.npm_config_user_agent||'')){console.error('Use pnpm instead');process.exit(1)}\"",
    "build": "pnpm -r --if-present run build",
    "build:web": "pnpm --filter @workspace/shothik run build",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "build:pipeline": "powershell -ExecutionPolicy Bypass -File ./scripts/build-production.ps1",
    "typecheck": "pnpm --filter @workspace/shothik run typecheck",
    "typecheck:api": "pnpm --filter @workspace/api-server run typecheck",
    "typecheck:all": "pnpm -r --if-present run typecheck",
    "test:api": "pnpm --filter @workspace/api-server run test",
    "test:artifacts": "npx tsx scripts/test-dynamic-artifacts.ts",
    "test:e2e": "npx tsx scripts/run-e2e-playwright.ts",
    "verify:frontend": "npx tsx scripts/verify-frontend-agent.ts",
    "verify:all": "pnpm typecheck:all && pnpm test:api && pnpm test:artifacts && pnpm test:e2e && pnpm --filter @workspace/swarm-orchestrator test && pnpm verify:frontend",
    "deploy:staging": "bash scripts/deploy-staging.sh",
    "deploy:docker": "docker-compose up -d --build",
    "deploy:cloudflare": "wrangler pages deploy artifacts/shothik/dist --project-name=shothik-hermes",
    "setup:ai": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-ai-env.ps1"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "0.27.3",
    "@eslint/eslintrc": "^3.3.1",
    "@insforge/cli": "^0.1.99",
    "@next/eslint-plugin-next": "16.2.3",
    "@playwright/test": "^1.59.1",
    "@rollup/rollup-win32-x64-msvc": "^4.62.4",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pdfmake": "^0.2.12",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/swagger-ui-react": "^5.18.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitest/coverage-v8": "^4.0.6",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jsdom": "^27.4.0",
    "lightningcss-win32-x64-msvc": "1.32.0",
    "prettier": "^3.6.2",
    "prettier-plugin-css-order": "^2.1.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "prisma": "7.4.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "@playwright/test": "^1.59.1",
    "axios": "^1.7.9",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "builtDependencies": [
      "@prisma/engines",
      "@scarf/scarf",
      "@tree-sitter-grammars/tree-sitter-yaml",
      "core-js-pure",
      "core-js",
      "esbuild",
      "prisma",
      "sharp",
      "tree-sitter-json",
      "tree-sitter",
      "unrs-resolver",
      "workerd"
    ]
  }
}
