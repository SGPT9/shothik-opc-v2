{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "dev": "pnpm --filter @workspace/shothik run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:mockup": "pnpm --filter @workspace/mockup-sandbox run dev",
    "dev:all": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-all.ps1",
    "preinstall": "node -e \"if(!/pnpm/.test(process.env.npm_config_user_agent||'')){console.error('Use pnpm instead');process.exit(1)}\"",
    "build": "pnpm -r --if-present run build",
    "build:web": "pnpm --filter @workspace/shothik run build",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "build:pipeline": "powershell -ExecutionPolicy Bypass -File ./scripts/build-production.ps1",
    "typecheck": "pnpm --filter @workspace/shothik run typecheck",
    "typecheck:api": "pnpm --filter @workspace/api-server run typecheck",
    "typecheck:all": "pnpm -r --if-present run typecheck",
    "test:all": "pnpm -r test",
    "test:run": "pnpm --filter @workspace/api-server test",
    "test:api": "pnpm --filter @workspace/api-server run test",
    "test:ecc": "pnpm --filter @workspace/api-server test",
    "pre-commit": "node scripts/ci/pre-commit-check.mjs",
    "lint:security": "node scripts/ci/pre-commit-check.mjs",
    "test:artifacts": "npx tsx scripts/test-dynamic-artifacts.ts",
    "test:e2e": "npx tsx scripts/run-e2e-playwright.ts",
    "verify:frontend": "npx tsx scripts/verify-frontend-agent.ts",
    "verify:all": "pnpm typecheck:all && pnpm test:api && pnpm test:artifacts && pnpm test:e2e && pnpm --filter @workspace/swarm-orchestrator test && pnpm verify:frontend",
    "deploy:staging": "bash scripts/deploy-staging.sh",
    "deploy:docker": "docker-compose up -d --build",
    "deploy:cloudflare": "wrangler deploy",
    "setup:ai": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-ai-env.ps1"
  },
  "private": true,
  "dependencies": {
    "@receptron/laya": "^0.1.2",
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "@cloudflare/kv-asset-handler": "^0.5.0",
    "@esbuild/win32-x64": "0.27.3",
    "@eslint/eslintrc": "^3.3.7",
    "@insforge/cli": "^0.1.100",
    "@next/eslint-plugin-next": "16.2.3",
    "@playwright/test": "^1.62.1",
    "@rollup/rollup-win32-x64-msvc": "^4.63.1",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/pdfmake": "^0.2.13",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/swagger-ui-react": "^5.18.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "lightningcss-win32-x64-msvc": "1.32.0",
    "prettier": "^3.9.6",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "prisma": "7.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },

  "overrides": {
    "@playwright/test": "^1.59.1",
    "axios": "^1.19.0",
    "dompurify": ">=3.2.4",
    "proxy-addr": ">=2.0.8",
    "tinypool": ">=2.1.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "onlyBuiltDependencies": [
    "@prisma/engines",
    "@scarf/scarf",
    "@tree-sitter-grammars/tree-sitter-yaml",
    "better-sqlite3",
    "core-js-pure",
    "core-js",
    "esbuild",
    "prisma",
    "sharp",
    "tree-sitter-json",
    "tree-sitter",
    "unrs-resolver",
    "workerd",
    "onnxruntime-node"
  ]
}
