# API gateway (Express) — proxies /api to the Shothik backend (shothikgpt.com)
FROM cgr.dev/chainguard/node:latest-dev AS build
WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY artifacts/api-server/package.json artifacts/api-server/
COPY lib lib
RUN npm install -g pnpm && pnpm install --frozen-lockfile --filter @workspace/api-server...
COPY artifacts/api-server artifacts/api-server
RUN pnpm --filter @workspace/api-server run build

FROM cgr.dev/chainguard/node:latest
WORKDIR /app
RUN mkdir -p /app/data && chown -R node:node /app
COPY --from=build --chown=node:node /app/artifacts/api-server/dist ./dist
USER node
ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080
CMD ["node", "--enable-source-maps", "dist/index.mjs"]
