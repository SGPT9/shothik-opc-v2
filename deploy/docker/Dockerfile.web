# Shothik frontend (Vite build served by nginx, /api proxied to the api container)
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY artifacts/shothik/package.json artifacts/shothik/
COPY lib lib
RUN pnpm install --frozen-lockfile --filter @workspace/shothik...
COPY artifacts/shothik artifacts/shothik
# Convex URL is baked into the bundle at build time
ARG VITE_CONVEX_URL=https://dashing-mandrill-233.convex.cloud
ENV VITE_CONVEX_URL=$VITE_CONVEX_URL
RUN pnpm --filter @workspace/shothik run build

FROM nginx:alpine
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/artifacts/shothik/dist /usr/share/nginx/html
EXPOSE 80
